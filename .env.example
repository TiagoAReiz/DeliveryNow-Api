# ==========================================
# DELIVERYNOW API - Environment Variables
# ==========================================
# Copy this file to .env and update with your own values
#
# IMPORTANT:
# - Never commit .env to version control
# - Keep your secrets secure
# - Use strong passwords in production

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=deliverynow
DB_HOST=localhost
DB_PORT=5432

# ==========================================
# APPLICATION SECURITY
# ==========================================
# Change this to a secure random key in production!
APP_SECRET_KEY=change-me

# ==========================================
# AZURE STORAGE (AZURITE)
# ==========================================
# The values below are Azurite's publicly documented development account
# (https://learn.microsoft.com/azure/storage/common/storage-use-azurite#well-known-storage-account-and-key).
# They only work against the local emulator. The key must be valid Base64,
# otherwise the API fails to start. Use a real account key in production.
STORAGE_ACCOUNT_NAME=devstoreaccount1
STORAGE_ACCOUNT_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==
STORAGE_BLOB_ENDPOINT=http://127.0.0.1:10000/devstoreaccount1

# ==========================================
# FILE UPLOAD LIMITS
# ==========================================
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB

# ==========================================
# JPA/HIBERNATE CONFIGURATION
# ==========================================
HIBERNATE_DDL_AUTO=update
HIBERNATE_SHOW_SQL=true
HIBERNATE_FORMAT_SQL=true

# ==========================================
# JVM CONFIGURATION (for Docker)
# ==========================================
JAVA_OPTS=-Xmx512m -Xms256m -XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0
